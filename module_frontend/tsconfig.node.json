{
  "compilerOptions": {
    "composite": true,                   // ✅ Required for referenced projects
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",                   // Added target
    "lib": ["ES2020"],                     // Added lib
    "emitDeclarationOnly": false,          // ✅ Explicitly set emit
    "declaration": true,                   // Generate declarations
    "declarationMap": true,                 // Generate declaration maps
    "outDir": "./dist-node"                 // Output directory for node types
  },
  "include": ["vite.config.ts"]
}