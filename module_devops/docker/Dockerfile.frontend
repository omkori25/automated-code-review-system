# module_devops/docker/Dockerfile.frontend
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY module_frontend/package*.json ./
RUN npm ci

# Copy application code
COPY module_frontend/ .

# Build the app
RUN npm run build

# Install serve to run the application
RUN npm install -g serve

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]